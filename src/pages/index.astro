---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppContact from '../components/WhatsAppContact.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import MobileMenu from '../components/MobileMenu.astro';
import CvPreview from '../components/CvPreview.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/muhamad-yayah-formal.png';

const highlights = [
  { label: 'PERKEMBANGAN KARIER', title: 'Dari HR Officer hingga Assistant Manager HRD', description: 'Berkembang dari HR Officer menjadi HRD Supervisor di PT Recon Sarana Utama. Kini menjabat sebagai Assistant Manager HRD di PT ITCI Kartika Utama.', context: 'Berkarier di HR sejak November 2020' },
  { label: 'PENGGAJIAN', title: 'Penggajian yang akurat dan tepat waktu', description: 'Mengelola administrasi kompensasi dan tunjangan untuk memastikan gaji karyawan dibayarkan secara akurat dan tepat waktu.', context: 'PT Ammar Abikara Indonesia' },
  { label: 'PROSEDUR & AUDIT', title: 'Prosedur HR dan dokumentasi ISO', description: 'Mengembangkan prosedur, instruksi kerja, dan dokumentasi ISO di bidang HR, serta mengoordinasikan audit internal dan eksternal.', context: 'PT ITCI Kartika Utama' },
];

const expertise = [
  { title: 'Operasional & administrasi HR', text: 'Mengelola kontrak kerja, data karyawan, HRIS, kehadiran, dan cuti untuk menjaga ketertiban administrasi kepegawaian.', tags: 'HRIS / Kontrak kerja / Administrasi' },
  { title: 'Penggajian & tunjangan', text: 'Menangani penggajian, kompensasi, dan tunjangan dengan memperhatikan keakuratan data serta ketepatan waktu pembayaran.', tags: 'Payroll / Compensation & benefits' },
  { title: 'Rekrutmen & pengembangan', text: 'Mengoordinasikan perencanaan tenaga kerja, seleksi, wawancara, orientasi karyawan baru, serta program pelatihan.', tags: 'Manpower planning / Recruitment / Training' },
  { title: 'Hubungan karyawan', text: 'Menangani keluhan, kedisiplinan, dan persoalan kinerja melalui komunikasi dengan karyawan, manajemen, serta instansi ketenagakerjaan.', tags: 'Employee relations / Labor relations' },
  { title: 'Prosedur & audit HR', text: 'Menyusun SOP, instruksi kerja, dan dokumentasi ISO, serta mengoordinasikan kebutuhan audit internal dan eksternal HR.', tags: 'SOP / Dokumentasi ISO / Audit' },
  { title: 'Anggaran & pelaporan', text: 'Menyusun rencana kerja dan anggaran HR tahunan, analisis tenaga kerja, serta laporan untuk mendukung keputusan manajemen.', tags: 'HR budgeting / Workforce reporting' },
];
const experience = [
  { period: 'Mei 2025 — sekarang', role: 'Assistant Manager HRD', company: 'PT ITCI Kartika Utama', current: true, details: ['Memimpin operasional HR sehari-hari dan mengawasi staf HR dalam pengelolaan gaji, tunjangan, kontrak kerja, serta administrasi karyawan.', 'Mengoordinasikan rekrutmen dan pengembangan karyawan; menyusun rencana kerja, anggaran tahunan, dan laporan tenaga kerja.', 'Menangani hubungan dengan karyawan serta mengembangkan prosedur dan dokumentasi ISO untuk kebutuhan audit HR.'] },
  { period: 'Desember 2023 — Mei 2025', role: 'HRD Supervisor', company: 'PT Jaya Proyek Servis', details: ['Mengelola penggajian, kompensasi, tunjangan, dan kontrak kerja serta mendukung pengelolaan sistem HR.', 'Mengoordinasikan rekrutmen dan orientasi karyawan baru, menangani keluhan serta persoalan kinerja, dan berkomunikasi dengan manajemen serta instansi ketenagakerjaan.'] },
  { period: 'Januari 2022 — Desember 2024', role: 'Senior HR Officer & Project Coordinator', company: 'PT Ammar Abikara Indonesia', details: ['Mengelola penggajian, administrasi kompensasi dan tunjangan, kontrak kerja, serta mendukung proses rekrutmen.', 'Mengoordinasikan persoalan ketenagakerjaan, menyusun anggaran bulanan dan tahunan, serta berkomunikasi dengan instansi ketenagakerjaan.'] },
  { period: 'November 2020 — Desember 2022', role: 'HR Officer → HRD Supervisor', company: 'PT Recon Sarana Utama', details: ['Berkembang dari HR Officer menjadi HRD Supervisor dengan tanggung jawab pada sistem dan operasional HR.', 'Mengelola penggajian, tunjangan, kontrak kerja, rekrutmen, orientasi karyawan baru, dan hubungan dengan karyawan.'] },
];

---

<BaseLayout>
  <WhatsAppContact />
  <a class="skip-link" href="#konten">Langsung ke konten</a>
  <header class="site-header">
    <nav class="container" aria-label="Navigasi utama">
      <a class="brand" href="#beranda"><span>Muhamad Yayah<small>Human Resources</small></span></a>
      <div class="nav-links"><a href="#profil">Profil</a><a href="#kompetensi">Kompetensi</a><a href="#pengalaman">Pengalaman</a></div>
      <div class="header-actions"><LanguageSwitcher /><a class="nav-contact" href="#kontak">Kontak <span aria-hidden="true">↗</span></a><MobileMenu /></div>
    </nav>
  </header>

  <main id="konten">
    <section class="hero container" id="beranda" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="rule"></span> PROFESIONAL SUMBER DAYA MANUSIA</p>
        <h1 id="hero-title">Muhamad<br />Yayah<span class="name-dot">.</span></h1>
        <p class="hero-role">Assistant Manager HRD</p>
        <p class="hero-description">Lebih dari lima tahun menangani pengelolaan sumber daya manusia, mulai dari penggajian dan rekrutmen hingga hubungan dengan karyawan dan pengembangan prosedur HR.</p>
        <div class="hero-actions"><a class="button button-primary" href="/documents/CV_Muhamad_Yayah_ATS.pdf" download="CV_Muhamad_Yayah_ATS.pdf">Unduh CV <span aria-hidden="true">↓</span></a><CvPreview /><a class="text-link" href="#pengalaman">Lihat pengalaman <span aria-hidden="true">↗</span></a></div>
        <p class="location"><svg width="15" height="18" viewBox="0 0 18 22" fill="none" aria-hidden="true"><path d="M16 9c0 5-7 11-7 11S2 14 2 9a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg> Balikpapan, Indonesia</p>
      </div>
      <figure class="portrait">
        <div class="portrait-stage"><Image src={portrait} alt="Muhamad Yayah mengenakan jas navy dan kemeja putih" widths={[300, 460, 600]} sizes="(max-width: 700px) 230px, 300px" format="webp" loading="eager" fetchpriority="high" /></div>
        <figcaption><span>POSISI SAAT INI</span><strong>Assistant Manager HRD</strong><p>PT ITCI Kartika Utama</p></figcaption>
      </figure>
    </section>

    <div class="summary-band"><div class="container"><p><strong>5+</strong><span>Tahun pengalaman di HR</span></p><p><strong>50+</strong><span>Karyawan yang pernah dipimpin<br /><small>Dalam operasional restoran</small></span></p><p><strong>HR & operasional</strong><span>Pengalaman kerja di Indonesia dan Abu Dhabi</span></p></div></div>

    <section class="section container profile-section" id="profil">
      <div class="section-side"><p class="eyebrow">01 / PROFIL</p><h2>Mengenal saya.</h2></div>
      <div class="profile-content"><p class="intro-text">Saya memulai karier di industri perhotelan dan restoran sebelum beralih ke bidang HR. Pengalaman memimpin tim operasional menjadi bekal untuk memahami kebutuhan karyawan dan perusahaan.</p><p>Saat ini saya menjabat sebagai Assistant Manager HRD di PT ITCI Kartika Utama. Tanggung jawab saya mencakup operasional HR, pengawasan staf, penggajian, rekrutmen, penyusunan anggaran, serta koordinasi audit.</p><p>Saya terbiasa berkomunikasi dengan karyawan, manajemen, dan instansi ketenagakerjaan untuk menyelesaikan persoalan administrasi maupun hubungan kerja.</p><div class="profile-details"><div><span>PENDIDIKAN SAAT INI</span><strong>S1 Hukum · sedang ditempuh</strong><p>Universitas Terbuka, Fakultas Hukum<br />2023 — sekarang</p></div><div><span>BAHASA & PERANGKAT KERJA</span><strong>Bahasa Indonesia & bahasa Inggris</strong><p>Bahasa Inggris untuk komunikasi kerja<br />Microsoft Office dan administrasi HRIS</p></div></div></div>
    </section>

    <section class="highlights-section" id="pencapaian"><div class="container section">
      <div class="section-heading"><div><p class="eyebrow">SOROTAN KARIER</p><h2>Pencapaian & kontribusi.</h2></div><p>Perkembangan karier dan kontribusi<br class="desktop-break" /> dalam pengelolaan SDM.</p></div>
      <div class="highlights-grid">{highlights.map((item) => <article class="highlight"><p class="highlight-label">{item.label}</p><h3>{item.title}</h3><p class="highlight-description">{item.description}</p><p class="highlight-context">{item.context}</p></article>)}</div>
    </div></section>

    <section class="expertise-section" id="kompetensi"><div class="container section">
      <div class="section-heading"><div><p class="eyebrow">02 / KOMPETENSI</p><h2>Bidang yang saya tangani.</h2></div><p>Pengalaman dalam operasional HR,<br class="desktop-break" /> administrasi, dan hubungan kerja.</p></div>
      <div class="expertise-grid">{expertise.map((item, index) => <article class="expertise-item"><div class="item-number">0{index + 1}</div><h3>{item.title}</h3><p>{item.text}</p><span class="item-tags">{item.tags}</span></article>)}</div>
    </div></section>

    <section class="ga-section" id="general-affairs" aria-labelledby="ga-heading">
      <div class="container ga-layout">
        <div class="ga-intro"><p class="eyebrow">GENERAL AFFAIRS</p><h2 id="ga-heading">Dukungan untuk<br />operasional perusahaan.</h2><p>Selain pekerjaan HR, saya menggunakan sistem internal untuk administrasi inventaris dan aset. Pengalaman operasional sebelumnya juga mencakup penyusunan anggaran, pemesanan kebutuhan, dan koordinasi pemeliharaan.</p><a class="text-link" href="#perangkat-kerja">Lihat perangkat kerja <span aria-hidden="true">↓</span></a></div>
        <div class="ga-details">
          <article><span class="ga-number" aria-hidden="true">01</span><div><p class="ga-context">ADMINISTRASI GA</p><h3>Inventaris & pencatatan aset</h3><p>Menggunakan sistem internal perusahaan untuk mendukung pencatatan inventaris dan aset dalam pekerjaan sehari-hari.</p></div></article>
          <article><span class="ga-number" aria-hidden="true">02</span><div><p class="ga-context">PENGALAMAN OPERASIONAL</p><h3>Anggaran & kebutuhan operasional</h3><p>Pengalaman menyusun anggaran bulanan dan tahunan, analisis biaya, serta mengawasi pembukuan dan pemesanan kebutuhan saat menjabat sebagai Assistant Store Manager.</p><small>PT Richeese Kuliner Indonesia</small></div></article>
          <article><span class="ga-number" aria-hidden="true">03</span><div><p class="ga-context">PENGALAMAN OPERASIONAL</p><h3>Koordinasi pemeliharaan</h3><p>Mengoordinasikan pemeliharaan sebagai bagian dari tanggung jawab operasional restoran, bersama pengelolaan tim dan kebutuhan kerja sehari-hari.</p><small>PT Richeese Kuliner Indonesia</small></div></article>
        </div>
      </div>
    </section>

    <section class="work-tools container" id="perangkat-kerja" aria-labelledby="tools-heading">
      <div class="tools-heading"><div><p class="eyebrow">PERANGKAT KERJA</p><h2 id="tools-heading">Tools pendukung pekerjaan.</h2></div><button class="tools-pause" type="button" aria-pressed="false" aria-controls="tools-marquee">Jeda animasi</button></div>
      <p class="tools-description">Perangkat yang saya gunakan untuk administrasi SDM, kepesertaan BPJS, serta pencatatan inventaris dan aset.</p>
      <div class="tools-marquee" id="tools-marquee">
        <div class="tools-track">
          {[0, 1].map((copy) => <div class="tools-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            <div class="tools-set">
              <div class="tool-mark"><svg class="office-mark" viewBox="0 0 32 36" aria-hidden="true"><path fill="#d83b01" d="m5 7 16-6 10 4v27l-10 3-16-6 16 2V7L11 9v17l-6 3Z"/></svg><span>Microsoft Office<small>Produktivitas</small></span></div>
              <div class="tool-mark"><svg class="system-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="2" y="4" width="28" height="24" rx="5"/><circle cx="12" cy="13" r="3"/><path d="M6 23c0-6 12-6 12 0M23 11h3M23 16h3M23 21h3"/></svg><span>Talenta<small>HRIS · Administrasi SDM</small></span></div>
              <div class="tool-mark"><svg class="system-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="m3 9 13-6 13 6v15l-13 6-13-6V9Zm0 0 13 6 13-6M16 15v15M9 6l13 6"/></svg><span>Sistem internal<small>Inventaris & aset</small></span></div>
              <div class="tool-mark"><svg class="system-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="m16 3 11 4v9c0 6-6 10-11 13C11 26 5 22 5 16V7l11-4Z"/><path d="M16 10v12M10 16h12"/></svg><span>e-Dabu<small>BPJS Kesehatan</small></span></div>
              <div class="tool-mark"><svg class="system-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="4" y="9" width="24" height="19" rx="3"/><path d="M11 9V5h10v4M4 16h24M13 16v4h6v-4"/></svg><span>SIPP<small>BPJS Ketenagakerjaan</small></span></div>
              <div class="tool-mark"><svg class="system-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M7 4h18a4 4 0 0 1 4 4v13a4 4 0 0 1-4 4H12l-7 4v-5a4 4 0 0 1-2-3V8a4 4 0 0 1 4-4Z"/><path d="M10 12h12M10 18h8"/></svg><span>Chatbot AI<small>Asisten digital</small></span></div>
            </div>
          </div>)}
        </div>
      </div>
    </section>

    <section class="section container" id="pengalaman">
      <div class="section-heading"><div><p class="eyebrow">03 / PENGALAMAN</p><h2>Riwayat pengalaman kerja.</h2></div><p>Dari HR Officer hingga<br class="desktop-break" /> Assistant Manager HRD.</p></div>
      <div class="experience-list">{experience.map((job) => <article class:list={['job', { 'current-job': job.current }]}><div class="job-period"><span class="timeline-point" aria-hidden="true"></span><p>{job.period}</p>{job.current && <span class="current-label">Posisi saat ini</span>}</div><div class="job-body"><p class="job-company">{job.company}</p><h3>{job.role}</h3><ul>{job.details.map((detail) => <li>{detail}</li>)}</ul></div></article>)}</div>
    </section>

    <section class="background-section"><div class="container section background-grid"><div><p class="eyebrow">04 / LATAR BELAKANG</p><h2>Bekal dari dunia operasional.</h2><p class="background-intro">Memimpin tim di industri perhotelan dan restoran memberi saya pengalaman langsung dalam pelatihan, evaluasi kinerja, serta pengelolaan kebutuhan operasional sehari-hari.</p></div><div class="background-list"><article><p class="small-label">September 2017 — 2019</p><h3>Assistant Store Manager</h3><p>PT Richeese Kuliner Indonesia</p><p class="background-detail">Memimpin lebih dari 50 karyawan, menangani pelatihan dan evaluasi kinerja, serta menyusun anggaran dan laporan operasional.</p></article><article><p class="small-label">2015 — 2017 & 2019 — 2020</p><h3>Perhotelan di Abu Dhabi</h3><p>St. Regis Hotel · Fairmont Bab Al Bahr</p><p class="background-detail">Bekerja sebagai Commis 2 di St. Regis Hotel dan Commis 1 di Fairmont Bab Al Bahr dalam lingkungan kerja internasional.</p></article><article><p class="small-label">2012 — 2015</p><h3>Pendidikan Diploma</h3><p>Politeknik Negeri Balikpapan</p></article></div></div></section>

    <section class="contact-section" id="kontak"><div class="container contact-grid"><div><p class="eyebrow">KONTAK</p><h2>Mari terhubung.</h2><p>Untuk diskusi profesional atau kesempatan<br class="desktop-break" /> di bidang HR dan HRGA.</p></div><div class="contact-links"><a href="mailto:yahya.bozz93@gmail.com"><span>EMAIL</span><strong>yahya.bozz93@gmail.com</strong><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="tel:+6281253481561"><span>TELEPON</span><strong>+62 812-5348-1561</strong><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/muhamad-yayah-031589100/" target="_blank" rel="noopener noreferrer" aria-label="Profil LinkedIn Muhamad Yayah, dibuka di tab baru"><span>LINKEDIN</span><strong>Muhamad Yayah</strong><span class="contact-arrow" aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <footer class="container"><span>© {new Date().getFullYear()} Muhamad Yayah</span><span>Balikpapan, Indonesia</span><a href="#beranda">Kembali ke atas ↑</a></footer>

</BaseLayout>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-header a[href^="#"]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
  let scheduled = false;
  function updateNavigation() {
    scheduled = false;
    const offset = (header?.offsetHeight || 100) + 32;
    document.documentElement.style.setProperty('--header-offset', `${offset}px`);
    let active = 'beranda';
    for (const section of sections) if (section.getBoundingClientRect().top <= offset) active = section.id;
    navLinks.forEach((link) => {
      if (link.hash === `#${active}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  function scheduleNavigation() { if (!scheduled) { scheduled = true; requestAnimationFrame(updateNavigation); } }
  window.addEventListener('scroll', scheduleNavigation, { passive: true });
  window.addEventListener('resize', scheduleNavigation);
  if (header) new ResizeObserver(scheduleNavigation).observe(header);
  updateNavigation();
  const pauseButton = document.querySelector<HTMLButtonElement>('.tools-pause');
  const marquee = document.querySelector<HTMLElement>('#tools-marquee');
  pauseButton?.addEventListener('click', () => {
    if (!marquee) return;
    const paused = marquee.dataset.paused !== 'true';
    marquee.dataset.paused = String(paused);
    pauseButton.setAttribute('aria-pressed', String(paused));
    pauseButton.textContent = document.documentElement.lang === 'en'
      ? (paused ? 'Play animation' : 'Pause animation')
      : (paused ? 'Putar animasi' : 'Jeda animasi');
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Source+Sans+3:wght@400;500;600;700&display=swap');
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth;scroll-padding-top:30px}
  :global(body){margin:0;background:#faf9f6;color:#223344;font-family:'Source Sans 3',sans-serif;font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}
  :global(a){color:inherit}
  :global(a:focus-visible){outline:3px solid #318078;outline-offset:5px}
  :global(::selection){background:#d2e5df}
  .site-header{position:sticky;top:0;z-index:90}
  :global(html){scroll-padding-top:var(--header-offset,120px)!important}
  .hero-actions{flex-wrap:wrap}
  :global(.site-header a[aria-current="location"]){color:#236b62;text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:2px}
  @media(max-width:700px){.header-actions .nav-contact{display:none}}
  .ga-section{background:#edf1ee;border-bottom:1px solid #dce3de}.ga-layout{display:grid;grid-template-columns:1fr 1.3fr;gap:80px;padding-block:80px}.ga-intro h2{font-size:35px}.ga-intro>p:not(.eyebrow){font-size:16px;line-height:1.8;color:#62746b;margin:24px 0}.ga-details article{display:flex;gap:22px;border-top:1px solid #cad7cd;padding:24px 0}.ga-details article:last-child{padding-bottom:0}.ga-number{font-size:11px;color:#6d8b7a;padding-top:3px}.ga-context{font-size:9px;letter-spacing:.12em;color:#376f62;margin:0 0 7px}.ga-details h3{font-size:21px;line-height:1.35;margin:0 0 11px}.ga-details article div>p:not(.ga-context){font-size:14px;line-height:1.75;color:#62746b;margin:0}.ga-details small{display:block;font-size:11px;color:#74867a;margin-top:12px}
  @media(max-width:960px){.ga-layout{gap:35px}.ga-intro h2{font-size:30px}}
  @media(max-width:700px){.ga-layout{grid-template-columns:1fr;padding-block:50px;gap:30px}.ga-intro h2{font-size:29px}.ga-details h3{font-size:19px}}
  .header-actions{display:flex;align-items:center;gap:23px;flex-shrink:0}
  @media(max-width:700px){.header-actions{gap:10px}.site-header nav{gap:10px;flex-wrap:wrap;padding-block:14px}.header-actions .nav-contact{font-size:12px;gap:4px}}
  .work-tools{min-width:0;padding-block:65px;border-bottom:1px solid #dce3de}
  .tools-heading{display:flex;justify-content:space-between;align-items:end;gap:20px}.tools-heading .eyebrow{margin-bottom:14px}.tools-heading h2{font-size:30px}.tools-description{font-size:14px;color:#68776e;margin:16px 0 30px}
  .tools-pause{flex-shrink:0;font:inherit;font-size:12px;color:#376f62;border:1px solid #cbd9d1;border-radius:4px;background:transparent;padding:7px 12px;cursor:pointer}.tools-pause:hover{background:#edf2ed}.tools-pause:focus-visible{outline:2px solid #376f62;outline-offset:4px}
  .tools-marquee{overflow:hidden;max-width:100%;padding-block:24px;border-block:1px solid #e1e7e1;mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
  .tools-track{display:flex;width:max-content;animation:tools-scroll 38s linear infinite}.tools-group,.tools-set{display:flex;flex-shrink:0}.tool-mark{width:240px;display:flex;align-items:center;gap:14px;padding-inline:24px;flex-shrink:0;white-space:nowrap}.tool-mark svg{width:32px;height:36px;flex-shrink:0}.system-mark{stroke:#376f62;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.tool-mark>span{font-size:18px;font-weight:600;line-height:1.3;letter-spacing:-.025em}.tool-mark small{display:block;font-size:11px;font-weight:400;letter-spacing:0;color:#7b8980;margin-top:5px}
  .tools-marquee:hover .tools-track,.tools-marquee[data-paused="true"] .tools-track{animation-play-state:paused}
  @keyframes tools-scroll{to{transform:translateX(-50%)}}
  @media(max-width:700px){.work-tools{padding-block:45px}.tools-heading{align-items:start;flex-direction:column;gap:16px}.tools-heading h2{font-size:27px}.tools-description{margin-bottom:24px}.tool-mark{width:210px;padding-inline:18px}.tool-mark>span{font-size:16px}.tools-marquee{padding-block:20px}}
  @media(prefers-reduced-motion:reduce){.tools-track{animation:none;width:100%}.tools-group{width:100%}.tools-group[aria-hidden="true"],.tools-set[aria-hidden="true"],.tools-pause{display:none}.tools-set{width:100%;flex-wrap:wrap;gap:24px}.tools-marquee{mask-image:none}.tool-mark{padding-inline:0;width:auto;flex:1 1 200px}}
  .portrait{margin:0 auto;max-width:300px;width:100%}
  .portrait-stage{overflow:hidden;border:7px solid #fff;border-radius:9px;outline:1px solid #dce4de;background:#f3f4f2;box-shadow:0 12px 30px rgb(34 51 68 / 6%)}
