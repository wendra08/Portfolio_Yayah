---
const message = 'Halo Pak Yayah, saya melihat portofolio Bapak dan ingin berdiskusi mengenai kesempatan di bidang HR/HRGA.';
const url = `https://wa.me/6281253481561?text=${encodeURIComponent(message)}`;
---
<a class="whatsapp-contact" data-whatsapp href={url} target="_blank" rel="noopener noreferrer" aria-label="Hubungi Muhamad Yayah melalui WhatsApp, dibuka di tab baru">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.1-4.8A8.5 8.5 0 1 1 20.5 11.5Z" stroke="currentColor" stroke-width="1.7"/><path d="M8 7.5c-.8 1-.2 3.2 1.9 5.3s4.3 2.7 5.3 1.9l.8-1.3-2.4-1.3-.9.9c-1.4-.6-2.5-1.7-3.1-3.1l.9-.9L9.2 7l-1.2.5Z" fill="currentColor"/></svg>
  <span>WhatsApp</span>
</a>
<style>
  .whatsapp-contact{position:fixed;right:24px;bottom:max(24px,env(safe-area-inset-bottom));z-index:50;display:flex;align-items:center;gap:9px;padding:13px 18px;border-radius:28px;background:#236b52;color:white;text-decoration:none;font:600 14px 'Source Sans 3',sans-serif;box-shadow:0 4px 16px rgb(34 51 68 / 18%);border:1px solid #ffffff40}.whatsapp-contact:hover{background:#19553f}.whatsapp-contact:focus-visible{outline:3px solid #236b52;outline-offset:4px}
  :global(body){padding-bottom:76px}
  @media(max-width:700px){.whatsapp-contact{right:16px;bottom:max(16px,env(safe-area-inset-bottom));padding:12px 16px}}
  @media print{.whatsapp-contact{display:none}:global(body){padding-bottom:0}}
</style>
