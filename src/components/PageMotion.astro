<div class="welcome" aria-hidden="true">
  <div class="welcome-content">
    <p class="welcome-label">SELAMAT DATANG</p>
    <p class="welcome-name">Muhamad Yayah<span>.</span></p>
    <p class="welcome-role">Human Resources & General Affairs</p>
    <div class="welcome-line"></div>
  </div>
</div>

<script is:inline>
  // Decorative welcome: hidden without JavaScript, and always dismissed on a timer.
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      if (sessionStorage.getItem('portfolio-welcomed')) return;
      sessionStorage.setItem('portfolio-welcomed', 'true');
    } catch {}
    const welcome = document.querySelector('.welcome');
    if (!welcome) return;
    try {
      if (localStorage.getItem('portfolio-language') === 'en') {
        const label = welcome.querySelector('.welcome-label');
        if (label) label.textContent = 'WELCOME';
      }
    } catch {}
    welcome.classList.add('is-active');
    const dismiss = () => welcome.classList.remove('is-active');
    window.setTimeout(dismiss, 1450);
    document.addEventListener('keydown', dismiss, { once: true });
    window.addEventListener('pageshow', (event) => { if (event.persisted) dismiss(); });
  })();
</script>

<script>
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const targets = document.querySelectorAll<HTMLElement>(
    '.hero-copy, .portrait, .summary-band, .section-side, .profile-content, .section-heading, .highlight, .expertise-item, .ga-intro, .ga-details article, .work-tools, .job, .background-grid > div, .contact-grid > div'
  );
  let observer: IntersectionObserver | undefined;
  const setup = () => {
    observer?.disconnect();
    if (preference.matches || !('IntersectionObserver' in window)) {
      targets.forEach((item) => item.classList.remove('scroll-reveal', 'is-visible'));
      return;
    }
    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer?.unobserve(entry.target);
        }
      }
    }, { threshold: 0, rootMargin: '0px 0px -35px 0px' });
    targets.forEach((item) => {
      item.classList.add('scroll-reveal');
      observer?.observe(item);
    });
  };
  setup();
  preference.addEventListener('change', setup);
  // Keyboard navigation must never land on invisible content.
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Element) event.target.closest('.scroll-reveal')?.classList.add('is-visible');
  });
</script>

<style>
  .welcome{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;background:#223344;color:#faf9f6;padding:30px;text-align:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .55s ease,visibility .55s ease}
  .welcome.is-active{opacity:1;visibility:visible}
  .welcome-label{font:500 10px 'Source Sans 3',sans-serif;letter-spacing:.24em;color:#a7c7bb;margin:0 0 20px}
  .welcome-name{font:400 clamp(32px,6vw,62px)/1.2 'Lora',Georgia,serif;letter-spacing:-.04em;margin:0}
  .welcome-name span{color:#a7c7bb}
  .welcome-role{font:400 13px 'Source Sans 3',sans-serif;color:#b7c4cc;margin:16px 0 30px}
  .welcome-line{height:1px;width:90px;background:#91b7a7;margin:auto;transform-origin:left}
  .is-active .welcome-line{animation:welcome-line 1.3s ease both}
  .is-active .welcome-content{animation:welcome-enter .6s ease both}
  @keyframes welcome-line{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes welcome-enter{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  :global(.scroll-reveal){opacity:0;transform:translateY(20px);transition:opacity .65s ease,transform .65s cubic-bezier(.22,.61,.36,1)}
  :global(.scroll-reveal.is-visible){opacity:1;transform:none}
  :global(.highlight:nth-child(2)),:global(.expertise-item:nth-child(3n + 2)){transition-delay:65ms}
  :global(.highlight:nth-child(3)),:global(.expertise-item:nth-child(3n)){transition-delay:130ms}
  @media(prefers-reduced-motion:reduce){.welcome{display:none}:global(.scroll-reveal){opacity:1;transform:none;transition:none}}
  @media print{.welcome{display:none}:global(.scroll-reveal){opacity:1!important;transform:none!important}}
</style>
