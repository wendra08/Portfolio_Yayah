---
import PageMotion from '../components/PageMotion.astro';
import { getImage } from 'astro:assets';
import portrait from '../assets/muhamad-yayah-formal.png';
const { title = 'Muhamad Yayah | HR & HRGA', animate = true, noindex = false } = Astro.props;
const description = 'HR professional dengan 5+ tahun pengalaman di HR operations, payroll, recruitment, dan employee relations.';
const socialImageUrl = 'https://muhamadyayah.my.id/og-image.jpg';
const publicSite = Astro.site;
const imageUrl = publicSite ? new URL('/og-image.jpg', publicSite).href : socialImageUrl;
const canonicalUrl = publicSite ? new URL(Astro.url.pathname, publicSite).href : undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {!noindex && <>
      {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Muhamad Yayah | Portofolio Profesional" />
      <meta property="og:title" content="Muhamad Yayah | Assistant Manager HRD" />
      <meta property="og:description" content={description} />
      <meta property="og:locale" content="id_ID" />
      {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Muhamad Yayah, Assistant Manager HRD, mengenakan jas navy dan kemeja putih." />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="Muhamad Yayah | Assistant Manager HRD" />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={imageUrl} />
      <meta name="twitter:image:alt" content="Muhamad Yayah, Assistant Manager HRD" />
    </>}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    {animate && <PageMotion />}
    <slot />
  </body>
</html>
